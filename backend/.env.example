# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me

# Database (Postgres)
DB_NAME=agentic_hub
DB_USER=agentichubdb
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Dev-only helpers
# If YES, allows Sequelize to auto-alter tables to match models on startup (development only by default).
DB_SYNC_ALTER=YES

# If YES, allows destructive DB reset via: npm -w backend run db:reset
DB_RESET_CONFIRM=NO

# Optional: seed a support user + some owned blueprints (dev only)
SEED_SUPPORT_ENABLE=NO
SEED_SUPPORT_EMAIL=support@example.com
SEED_SUPPORT_PASSWORD=change-me
# If YES and user already exists, overwrites passwordHash
SEED_SUPPORT_OVERWRITE_PASSWORD=NO

# Seed owner for default blueprints (dev only)
# If not set, the seed will reuse SEED_SUPPORT_EMAIL, then GMAIL_USER, then fallback to seed@agentichub.local
SEED_DEFAULT_EMAIL=seed@agentichub.local
SEED_DEFAULT_PASSWORD=change-me
SEED_DEFAULT_OVERWRITE_PASSWORD=NO

# Email (Gmail OAuth2)
GMAIL_USER=change-me
GMAIL_CLIENT_ID=change-me
GMAIL_CLIENT_SECRET=change-me
GMAIL_REFRESH_TOKEN=change-me

# FRONTEND URL
FRONTEND_URL=http://localhost:5173

# Token GitHub
TOKEN_GITHUB=your_token
